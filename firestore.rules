rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'sesc@gmail.com';
    }
    function isStaff() {
      return request.auth != null && (request.auth.token.email == 'staff@sesc.com' || isAdmin());
    }
    // Rate list, grouped by category: staff + admin read, only admin writes
    match /cats/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Category list (names, icons, order): staff + admin read, only admin writes
    match /meta/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Item photos: staff + admin read, only admin writes
    match /photos/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Purchase prices: admin only
    match /costs/{id} {
      allow read, write: if isAdmin();
    }
    // Old-format items (only for the one-time "Move old items" step): admin only
    match /items/{id} {
      allow read, write: if isAdmin();
    }
    // Online staff count: logged-in devices write their "last seen", admin reads
    match /presence/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isStaff()
                            && request.resource.data.keys().hasOnly(['t'])
                            && request.resource.data.t == request.time;
    }
  }
}
